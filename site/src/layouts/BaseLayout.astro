---
import { COMPANY } from "../lib/site";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
interface Props { title: string; description: string; jsonLd?: object[]; noindex?: boolean; wide?: boolean; ogType?: string }
const { title, description, jsonLd = [], noindex = false, wide = false, ogType = "article" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={COMPANY.name} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
  {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  <GoogleAnalytics />
</head>
<body>
  <header class="site-header">
    <div class="wide header-inner">
      <a class="logo marumitsu-type rotor-brand" href="/" aria-label="株式会社飯田丸光部品 ホーム"><span class="delivery-mark" aria-hidden="true"><span class="truck-box"><span class="truck-lettering">飯田丸光部品</span></span><i class="truck-cab"></i><i class="truck-door" aria-hidden="true"></i><i class="truck-mirror"></i><i class="truck-bumper"></i><i class="truck-frame"></i><i class="truck-wheel"></i><i class="truck-wheel"></i></span></a>
      <nav>
        <a href="/parts/">取扱部品・用品</a>
        <a href="/company/">会社概要</a>
        <a href="/contact/">部品のお問い合わせ</a>
        <a href="/column/">部品コラム</a>
        <a href="/business/">法人のお客様</a>
        <a href="/#stores">店舗</a>
        <a href={COMPANY.telHref} class="nav-tel">☎ {COMPANY.tel}</a>
      </nav>
    </div>
  </header>
  <main class={wide ? "main-wide" : "wrap"}><slot /></main>
  <footer class="site-footer">
    <div class="wide">
      <div class="footer-info-grid"><div>
      <p class="f-name">{COMPANY.name}</p>
      {COMPANY.stores.map((st) => <p>{st.name}：{st.address}</p>)}
      <p>TEL <a href={COMPANY.telHref}>{COMPANY.tel}</a>（{COMPANY.hours}）</p>
      <p>FAX {COMPANY.fax}</p>
      <p>休業日　{COMPANY.closed}</p>
      <p><a href="/privacy/">アクセス解析について</a></p>
      </div><nav class="footer-parts" aria-labelledby="bottom-parts-title"><h2 id="bottom-parts-title">取扱部品・用品</h2><ul><li><a href="/parts/genuine/">純正部品・第2ブランド</a></li><li><a href="/parts/repair/">機能部品・消耗部品</a></li><li><a href="/parts/electrical/">電気・電装系部品</a></li><li><a href="/parts/recycled/">リビルト・中古部品</a></li><li><a href="/parts/chemical/">ケミカル・オイル</a></li><li><a href="/parts/tools/">工具・整備用品 <small>今後展開予定</small></a></li></ul></nav></div>
      <p class="f-copy">© {COMPANY.name}</p>
    </div>
  </footer>
</body>
</html>
<style is:global>
  :root { --dark: #0c1829; --gold: #c8a84e; --navy: #1a4b8e; --ink: #1d1d1f; --sub: #5f6368; --line: #e3e7ee; --bg-soft: #f5f8fc; --warn-bg: #fff7e6; --warn: #8a5300; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "Noto Sans JP", system-ui, sans-serif; color: var(--ink); background: #fff; line-height: 1.8; -webkit-font-smoothing: antialiased; }
  a { color: var(--navy); }
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 16px; }
  .wide { max-width: 1080px; margin: 0 auto; padding: 0 16px; }
  main.main-wide { padding: 0; }
  .site-header { border-bottom: 1px solid var(--line); background: #fff; position: sticky; top: 0; z-index: 10; }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 56px; flex-wrap: wrap; }
  .logo { font-weight: 700; color: var(--ink); text-decoration: none; }
  nav { display: flex; gap: 16px; font-size: 14px; flex-wrap: wrap; }
  nav a { text-decoration: none; color: var(--ink); }
  .nav-tel { color: var(--navy) !important; font-weight: 700; }
  main { padding: 24px 16px 56px; }
  h1 { font-size: 24px; line-height: 1.5; margin: 8px 0 16px; }
  h2 { font-size: 19px; margin: 40px 0 12px; padding-left: 10px; border-left: 4px solid var(--navy); line-height: 1.5; }
  h3 { font-size: 16px; margin: 28px 0 8px; }
  table { border-collapse: collapse; width: 100%; font-size: 14px; margin: 8px 0 4px; }
  th, td { border: 1px solid var(--line); padding: 8px 10px; text-align: left; vertical-align: top; }
  th { background: var(--bg-soft); font-weight: 500; }
  .table-scroll { overflow-x: auto; }
  .note { font-size: 13px; color: var(--sub); margin: 4px 0 0; }
  .site-footer { border-top: 1px solid var(--line); background: var(--bg-soft); font-size: 13px; color: var(--sub); padding: 24px 0; }
  .site-footer p { margin: 2px 0; }
  .f-name { font-weight: 700; color: var(--ink); }
  .f-copy { margin-top: 12px !important; }
  @media (max-width: 600px) {
    h1 { font-size: 21px; }
    .header-inner { flex-wrap: nowrap; min-height: 48px; }
    .logo { flex: none; font-size: 15px; }
    nav { flex-wrap: nowrap; overflow-x: auto; gap: 14px; font-size: 13px; white-space: nowrap; scrollbar-width: none; }
  }
</style>

<style is:inline>.site-header .rotor-brand{display:inline-flex;align-items:center;gap:9px;padding-bottom:0}.rotor-wordmark{display:grid;gap:4px}.rotor-description{font-size:10px;font-weight:650;letter-spacing:.1em;color:#41546b}.rotor-icon{position:relative;flex:none;width:43px;height:39px}.rotor-disc{position:absolute;inset:2px 7px 2px 1px;border:4px solid #0c1829;border-radius:50%;box-shadow:inset 0 0 0 1px #62778c}.rotor-disc:before{content:"";position:absolute;inset:8px;border:2px solid #0c1829;border-radius:50%}.rotor-disc i{position:absolute;width:3px;height:3px;border-radius:50%;background:#0c1829}.rotor-disc i:nth-child(1){left:8px;top:2px}.rotor-disc i:nth-child(2){left:3px;top:12px}.rotor-disc i:nth-child(3){left:8px;bottom:2px}.rotor-caliper{position:absolute;right:1px;top:7px;width:15px;height:23px;background:#aa7d24;border:2px solid white;border-radius:4px 8px 8px 4px;transform:rotate(-14deg)}@media(max-width:600px){.rotor-icon{transform:scale(.86);width:39px}.rotor-description{font-size:9px}}
.delivery-mark{position:relative;display:block;flex:none;width:52px;height:37px;color:#0c1829}.delivery-mark i{position:absolute;display:block}.truck-box{inset:4px 20px 11px 1px;border:2px solid currentColor;border-radius:3px;background:linear-gradient(to bottom,#fff 46%,#bb9240 46%,#bb9240 61%,#fff 61%)}.truck-cab{inset:10px 1px 10px 34px;background:currentColor;clip-path:polygon(0 0,63% 0,100% 45%,100% 100%,0 100%)}.truck-cab::before{content:"";position:absolute;inset:3px 3px auto 3px;height:6px;background:#fff;clip-path:polygon(0 0,58% 0,100% 100%,0 100%)}.truck-frame{inset:auto 1px 8px;height:4px;background:currentColor;border-radius:2px}.truck-wheel{bottom:3px;left:7px;width:11px;height:11px;background:currentColor;border:2px solid #fff;border-radius:50%}.truck-wheel:last-child{left:auto;right:5px}@media(max-width:600px){.delivery-mark{transform:scale(.88);margin-inline:-3px}}
.delivery-mark{width:95px}.delivery-mark .truck-box{position:absolute;inset:4px 1px 11px 23px;display:grid;place-items:center;background:#fff;border-bottom-color:#aa7d24}.truck-lettering{color:#0c1829;font-size:7px;font-weight:700;line-height:1;white-space:nowrap}.delivery-mark .truck-cab{inset:10px auto 10px 1px;width:20px;transform:scaleX(-1)}.delivery-mark .truck-wheel{left:8px}.delivery-mark .truck-wheel:last-child{left:auto;right:12px}@media(max-width:600px){.delivery-mark{transform:none;margin-inline:0;width:89px}.truck-lettering{font-size:6.5px}}
.site-header .rotor-brand{gap:0;padding:2px 0}
.delivery-mark{width:181px;height:46px;color:#102138}
.delivery-mark .truck-box{position:absolute;inset:2px 1px 11px 33px;display:grid;place-items:center;padding:0 4px 3px;border:0;border-radius:2px 3px 2px 2px;background:linear-gradient(to bottom,#102138 0 calc(100% - 3px),#c8a84e calc(100% - 3px));}
.delivery-mark .truck-cab{inset:9px auto 9px 1px;width:34px;transform:scaleX(-1);clip-path:polygon(0 0,55% 0,73% 12%,100% 59%,100% 100%,0 100%);}
.delivery-mark .truck-cab::before{inset:4px 5px auto 7px;height:9px;background:#e8eff6;clip-path:polygon(0 0,56% 0,100% 100%,0 100%);}
.delivery-mark .truck-cab::after{content:"";position:absolute;right:0;bottom:4px;width:5px;height:3px;background:#c8a84e;}
.delivery-mark .truck-frame{inset:auto 1px 8px;height:4px;}
.delivery-mark .truck-wheel{bottom:1px;left:11px;width:13px;height:13px;border:1.5px solid #fff;background:radial-gradient(circle,#8391a0 0 21%,#102138 25%);}
.delivery-mark .truck-wheel:last-child{left:auto;right:18px;}
@media(max-width:600px){.delivery-mark{transform:none;margin-inline:0;width:157px;height:43px}.truck-lettering{font-size:15px;letter-spacing:.035em}}
.delivery-mark{width:190px;height:49px}
.delivery-mark .truck-box{inset:2px 2px 13px 48px;border-radius:2px;border-left:1px solid #53647a;border-right:2px solid #53647a}
.delivery-mark .truck-cab{inset:8px auto 11px 5px;width:41px;transform:none;clip-path:polygon(21% 0,91% 0,100% 10%,100% 92%,76% 92%,73% 78%,65% 69%,53% 65%,40% 69%,31% 79%,28% 95%,0 95%,0 56%,5% 48%,8% 21%)}
.delivery-mark .truck-cab::before{inset:4px auto auto 6px;width:30px;height:12px;background:linear-gradient(to right,#c2d6e8 0 26%,#102138 26% 33%,#e8eff6 33%);clip-path:polygon(15% 0,100% 0,100% 88%,46% 100%,0 90%)}
.delivery-mark .truck-cab::after{right:auto;left:1px;bottom:5px;width:6px;height:3px;background:#d7b75b}
.delivery-mark .truck-frame{inset:auto 4px 10px 11px;height:4px}
.delivery-mark .truck-wheel{left:20px;bottom:2px;width:14px;height:14px}
.delivery-mark .truck-wheel:last-child{right:24px}
@media(max-width:600px){.delivery-mark{width:168px;height:49px}}
.footer-info-grid{display:grid;grid-template-columns:1fr auto;gap:22px 48px;align-items:start}.site-footer .footer-parts{display:block;white-space:normal;overflow:visible;text-align:left;min-width:180px}.site-footer .footer-parts h2{margin:0 0 6px;padding:0;border:0;font-size:14px}.footer-parts ul{margin:0;padding:0;list-style:none}.footer-parts li{margin:3px 0}.site-footer .footer-parts a{color:#1a4b8e;text-decoration:underline;text-underline-offset:2px}.footer-parts small{color:#52657c;margin-left:4px}@media(max-width:600px){.footer-info-grid{grid-template-columns:1fr;gap:14px}}</style>
