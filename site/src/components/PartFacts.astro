---
// 販売明細集計の表。値は frontmatter facts（集計スクリプトの出力）だけから出す。
import { ym } from "../lib/site";
const { facts, partLabel = facts.partName, excludedPartNumbers = [] } = Astro.props;
const excludedNumbers = new Set(excludedPartNumbers.map((item) => item.number));
const displayedPartNumbers = facts.partNumbers.filter((item) => !excludedNumbers.has(item.number));
const hasExclusions = excludedNumbers.size > 0;
const span = (ys: number[]) => (ys.length === 0 ? "年式不明" : ys[0] === ys.at(-1) ? `${ys[0]}年式` : `${ys[0]}〜${ys.at(-1)}年式`);
---
<section class="facts">
  <h2>{facts.vehicleName}（{facts.model}）の販売明細集計</h2>
  <p class="lead">{ym(facts.period[0])}〜{ym(facts.period[1])}の販売明細に、{facts.vehicleName} {facts.model} と {partLabel} の組み合わせとして記録された件数は{facts.shipments}件です。</p>
  {hasExclusions && <p class="note">この総件数には、適合未確認として表に掲載していない品番の販売明細も含みます。下の表には、該当品番を除いて掲載しています。</p>}
  <div class="table-scroll">
    <table>
      <thead><tr><th>品番</th><th>部品メーカー</th><th>集計件数</th><th>販売明細に記載された年式</th></tr></thead>
      <tbody>
        {displayedPartNumbers.map((p) => (
          <tr><td><strong>{p.number}</strong></td><td>{p.maker}</td><td>{p.count}件</td><td>{span(p.years)}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note">出典：{facts.source}（対象期間：{ym(facts.period[0])}〜{ym(facts.period[1])}）。件数は販売明細の行数で、販売個数・交換台数ではありません。この表は表示期間の取扱記録の紹介です。品番は車台番号とメーカーの適合情報から確認してください。</p>
  {!hasExclusions && facts.coParts.length > 0 && (
    <>
      <h3>同じ型式・車台番号・日付の明細に記録された部品</h3>
      <p class="note">各項目の件数は、同じ型式・車台番号・日付の記録にその部品が含まれた対象明細の行数です。交換回数ではなく、実際に一緒に交換されたかはこの集計からは分かりません。</p>
      <ul class="co">
        {facts.coParts.map((c) => <li>{c.name}<span>{c.count}件</span></li>)}
      </ul>
    </>
  )}
</section>
<style>
  .lead { margin: 0 0 8px; }
  .co { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .co li { background: var(--bg-soft); border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px; font-size: 14px; }
  .co span { color: var(--sub); margin-left: 6px; font-size: 12px; }
</style>
