---
import { Image } from "astro:assets";
import logo from "../assets/iida-marumitsu-header.png";
import { COMPANY } from "../lib/site";
---
<a class="site-brand" href="/" aria-label={`${COMPANY.name} ホーム`}>
  <Image src={logo} width={560} format="webp" alt="" loading="eager" />
</a>

<style>
  .site-brand { display: block; flex: 0 1 auto; min-width: 0; }
  .site-brand img { display: block; width: 248px; max-width: 100%; height: auto; }
  @media (max-width: 600px) {
    .site-brand img { width: clamp(144px, 44vw, 184px); }
  }
</style>
