---
import { COMPANY } from "../../lib/site";
---
<!doctype html>
<html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>部品のお問い合わせ｜飯田丸光部品</title>
<style is:inline> *{box-sizing:border-box}body{margin:0;background:#f7f8f4;color:#172827;font:16px/1.7 Meiryo,sans-serif}main{max-width:680px;margin:auto;padding:24px 18px}h1{color:#143e33}a{color:#235543}form{padding:20px;background:white;border:1px solid #d4ded5;border-radius:12px}label{display:block;font-weight:bold;margin:14px 0}input,textarea{display:block;width:100%;margin-top:4px;padding:9px;border:1px solid #82978a;border-radius:5px;font:inherit}button{background:#173b30;color:white;padding:8px 14px;border:0;border-radius:5px;font:inherit}#draft-box[hidden]{display:none}#copy{margin-top:8px}</style></head>
<body><main><a href="/parts/">← 取扱部品・用品へ戻る</a><h1>部品のお問い合わせ</h1><p>車両情報または純正品番を添えてお問い合わせください。</p><p>問い合わせ文を作成し、メールアプリで開けます。宛先は {COMPANY.email} です。</p>
<form data-recipient={COMPANY.email}><label>お名前・会社名（必須）<input name="name" autocomplete="name" required></label><label>メールアドレス（必須）<input name="email" autocomplete="email" type="email" required></label><label>お探しの部品（必須）<input name="part" required></label><label>車種<input name="vehicle" placeholder="例：ワゴンR"></label><label>型式<input name="model" placeholder="例：MH34S"></label><label>車台番号の数字部分<input name="serial" inputmode="numeric" pattern="[0-9]+" placeholder="例：1234567"></label><label>純正品番<input name="part-number"></label><label>補足<textarea name="message" rows="3"></textarea></label><button type="button" id="check">問い合わせ文を作成</button><label id="draft-box" hidden>完成した問い合わせ文<textarea id="draft" rows="14" readonly></textarea><button type="button" id="copy">コピー</button> <a id="email-draft">メールアプリで開く</a></label><p id="status" role="status"></p></form>
<p>お電話でのお問い合わせ <a href={COMPANY.telHref}>{COMPANY.tel}</a>（{COMPANY.hours}）</p></main>
<script is:inline>
const form = document.querySelector('form');
const draft = document.querySelector('#draft');
const status = document.querySelector('#status');
form.addEventListener('submit', event => event.preventDefault());
document.querySelector('#check').addEventListener('click', () => {
  status.textContent = '';
  if (!form.reportValidity()) return;
  const get = key => form.elements.namedItem(key).value.trim();
  if (!get('vehicle') && !get('model') && !get('part-number')) {
    status.textContent = '車種・型式、または純正品番を入力してください。';
    form.elements.namedItem('vehicle').focus();
    return;
  }
  if (get('serial') && !get('model')) {
    status.textContent = '車台番号の数字部分とあわせて、型式も入力してください。';
    form.elements.namedItem('model').focus();
    return;
  }
  const details = [['車種', 'vehicle'], [get('serial') ? '車台番号' : '型式', 'model'], ['純正品番', 'part-number'], ['補足', 'message']]
    .filter(([, key]) => get(key))
    .map(([label, key]) => label + '：' + get(key) + (key === 'model' && get('serial') ? '-' + get('serial') : ''));
  draft.value = [
    '株式会社飯田丸光部品 ご担当者様', '',
    '下記の部品について、適合・在庫・見積もりをご確認いただけますでしょうか。', '',
    'お探しの部品：' + get('part'), ...details, '',
    'お名前・会社名：' + get('name'), 'メールアドレス：' + get('email'), '',
    'よろしくお願いいたします。'
  ].join('\n');
  document.querySelector('#email-draft').href = 'mailto:' + form.dataset.recipient + '?subject=' + encodeURIComponent('部品のお問い合わせ') + '&body=' + encodeURIComponent(draft.value);
  document.querySelector('#draft-box').hidden = false;
  draft.focus();
});
document.querySelector('#copy').addEventListener('click', async () => {
  try {
    await navigator.clipboard.writeText(draft.value);
    status.textContent = '問い合わせ文をコピーしました。';
  } catch {
    draft.select();
    status.textContent = '選択した文をコピーしてください。';
  }
});
</script></body></html>




