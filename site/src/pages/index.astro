.delivery-mark .truck-cab::after{right:auto;left:1px;bottom:5px;width:6px;height:3px;background:#d7b75b}
.truck-door{left:35px;top:25px;width:6px;height:1px;background:#9cabbc}
.truck-mirror{left:2px;top:17px;width:8px;height:4px;background:#102138;border-radius:2px 1px 1px 2px;box-shadow:1px 1px 0 #dce5ee}
.truck-bumper{left:3px;bottom:10px;width:10px;height:3px;border-radius:1px;background:#617389}
.delivery-mark .truck-frame{inset:auto 4px 10px 11px;height:4px}
.delivery-mark .truck-wheel{left:20px;bottom:2px;width:14px;height:14px}
.delivery-mark .truck-wheel:last-child{right:24px}
