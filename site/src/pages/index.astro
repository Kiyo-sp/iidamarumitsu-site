---
// トップ。記載は現行サイト（docs/）と、仕入・販売実績で確認できた事実だけ。
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { COMPANY, GENUINE_MAKERS, AFTERMARKET_MAKERS, POPULAR_PARTS, isPublic } from "../lib/site";

const columns = (await getCollection("column", (e) => isPublic(e.data.status)))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 6);

const companyInfo: [string, string][] = [
  ["会社名", COMPANY.name],
  ["代表者", "水川慎也"],
  ["資本金", "1,200万円"],
  ["創業", "昭和53年（1978年）3月"],
  ["本店", COMPANY.stores[0].address],
  ["生田店", COMPANY.stores[1].address],
  ["TEL", COMPANY.tel],
  ["事業内容", "自動車部品・工具卸売業"],
  ["取引銀行", "飯田信用金庫、八十二銀行"],
  ["株主", "株式会社SPREAD（70%）／株式会社門田商店（30%）"],
];
const groups = [
  { name: "株式会社SPREAD", href: "https://spread-inc.co.jp/" },
  { name: "株式会社イー・エヌ・ドゥ", href: "https://e-n-do.com/" },
  { name: "株式会社門田商店", href: "https://kadota-works.co.jp/" },
];
const customers = ["整備工場", "板金・塗装工場", "カーディーラー", "中古車販売店", "タクシー・運送会社", "官公庁"];

const jsonLd = [{
  "@context": "https://schema.org", "@type": "AutoPartsStore", name: COMPANY.name, url: COMPANY.url + "/",
  description: "長野県飯田市の自動車部品・工具の専門卸売業。昭和53年創業。",
  telephone: COMPANY.tel, foundingDate: "1978",
  address: { "@type": "PostalAddress", streetAddress: "大久保町2565-6", addressLocality: "飯田市", addressRegion: "長野県", postalCode: "395-0053", addressCountry: "JP" },
  openingHours: "Mo-Fr 08:30-17:30",
  parentOrganization: { "@type": "Organization", name: "株式会社SPREAD" },
}];
const mapSrc = (q: string) => `https://maps.google.com/maps?q=${encodeURIComponent(q)}&z=14&output=embed`;
---
<BaseLayout
  title={`${COMPANY.name}｜長野県飯田市の自動車部品・工具卸売`}
  description="長野県飯田市の自動車部品・工具卸売。昭和53年創業。飯田本店と生田店の2拠点体制で1日複数回デリバリー。国産全メーカーの純正部品と主要な優良部品を取り扱っています。"
  jsonLd={jsonLd} ogType="website" wide
>
  <section class="hero">
    <div class="wide hero-inner">
      <p class="hero-kicker">長野県飯田市の自動車部品・工具卸　昭和53年創業</p>
      <h1>必要な部品を、<br />必要なときに。</h1>
      <p class="hero-lead">飯田の中心部と北部の2拠点から、整備工場・ディーラーの現場へ1日に何度でもお届けします。車台番号を伝えていただければ、品番はこちらでお調べします。</p>
      <div class="hero-actions">
        <a class="btn-gold" href={COMPANY.telHref}>☎ {COMPANY.tel}　電話で問い合わせる</a>
        <a class="btn-ghost" href="/column/">車種別の部品コラムを見る</a>
      </div>
      <p class="hero-hours">受付：{COMPANY.hours}</p>
      <ul class="hero-points">
        <li><strong>2拠点</strong><span>本店・生田店</span></li>
        <li><strong>1日複数回</strong><span>デリバリー</span></li>
        <li><strong>45年以上</strong><span>地域とともに</span></li>
      </ul>
    </div>
  </section>

  <section class="sec" id="parts">
    <div class="wide">
      <p class="sec-kicker">PARTS</p>
      <h2 class="sec-title">取扱部品</h2>
      <p class="sec-lead">国産全メーカーの純正部品と、主要メーカーの優良部品を取り扱っています。在庫にないものもお取り寄せします。</p>
      <div class="grid2">
        <div class="card">
          <h3>純正部品</h3>
          <ul class="chips">{GENUINE_MAKERS.map((m) => <li>{m}</li>)}</ul>
        </div>
        <div class="card">
          <h3>優良部品メーカー（主な取扱い）</h3>
          <ul class="chips">{AFTERMARKET_MAKERS.map((m) => <li>{m}</li>)}</ul>
        </div>
      </div>
      <div class="card card-wide">
        <h3>よくご注文いただく部品</h3>
        <ul class="chips chips-soft">{POPULAR_PARTS.map((m) => <li>{m}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="sec sec-soft" id="column">
    <div class="wide">
      <p class="sec-kicker">COLUMN</p>
      <h2 class="sec-title">部品コラム</h2>
      <p class="sec-lead">車種・型式ごとに、当社が実際に出荷した部品の品番と、交換の目安をまとめています。</p>
      <div class="col-grid">
        {columns.map((e) => (
          <a class="col-card" href={`/column/${e.id}/`}>
            <span class="col-car">{e.data.vehicle ? `${e.data.vehicle.maker} ${e.data.vehicle.name} ${e.data.vehicle.model}` : "部品の基礎"}</span>
            <span class="col-part">{e.data.part?.name}</span>
            {e.data.facts && <span class="col-meta">出荷実績 {e.data.facts.shipments}件 ／ 品番 {e.data.facts.partNumbers.length}種</span>}
          </a>
        ))}
      </div>
      <p class="more"><a href="/column/">コラムの一覧へ →</a></p>
    </div>
  </section>

  <section class="sec" id="business">
    <div class="wide">
      <p class="sec-kicker">FOR BUSINESS</p>
      <h2 class="sec-title">法人のお客様へ</h2>
      <p class="sec-lead">飯田・下伊那エリアの、さまざまな業種のお客様に部品をお届けしています。</p>
      <ul class="chips chips-lg">{customers.map((c) => <li>{c}</li>)}</ul>
      <div class="grid3">
        <div class="step"><span>1</span><p>お電話で、車台番号と必要な部品をお伝えください。</p></div>
        <div class="step"><span>2</span><p>品番と在庫・納期を確認してご連絡します。</p></div>
        <div class="step"><span>3</span><p>本店・生田店から、現場へお届けします。</p></div>
      </div>
      <p class="more"><a href="/business/">法人のお客様向けのご案内 →</a></p>
    </div>
  </section>

  <section class="sec sec-soft" id="stores">
    <div class="wide">
      <p class="sec-kicker">STORES</p>
      <h2 class="sec-title">店舗</h2>
      <p class="sec-lead">飯田中心部の本店と北側の生田店（2店舗間 約15km）。南北からエリア全体をカバーします。</p>
      <div class="grid2">
        {COMPANY.stores.map((st) => (
          <div class="store">
            <h3>{st.name}<small>{st.area}</small></h3>
            <p>{st.address}</p>
            <iframe title={`${st.name}の地図`} src={mapSrc(st.map)} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        ))}
      </div>
      <p class="sec-note">TEL {COMPANY.tel}（{COMPANY.hours}）</p>
    </div>
  </section>

  <section class="sec" id="shop">
    <div class="wide shop">
      <div>
        <p class="sec-kicker">ONLINE SHOP</p>
        <h2 class="sec-title">個人のお客様は、メルカリShopsでも</h2>
        <p class="sec-lead">一部の部品はメルカリShopsでも販売しています。</p>
      </div>
      <a class="btn-navy" href={COMPANY.mercari} target="_blank" rel="noopener">メルカリShopsで見る →</a>
    </div>
  </section>

  <section class="sec sec-soft" id="company">
    <div class="wide">
      <p class="sec-kicker">COMPANY</p>
      <h2 class="sec-title">会社概要</h2>
      <table class="company">
        <tbody>
          {companyInfo.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}
          <tr><th>グループ会社</th><td>{groups.map((g) => <a href={g.href} target="_blank" rel="noopener">{g.name}</a>)}</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="contact">
    <div class="wide">
      <h2>部品のお取り寄せ・在庫確認は、お気軽にお電話ください</h2>
      <a class="btn-gold" href={COMPANY.telHref}>☎ {COMPANY.tel}</a>
      <p>受付：{COMPANY.hours}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { background: radial-gradient(1200px 500px at 85% -10%, rgba(200,168,78,.18), transparent 60%), linear-gradient(160deg, var(--dark) 0%, #162544 55%, #1a3a5c 100%); color: #fff; }
  .hero-inner { padding-top: 64px; padding-bottom: 56px; }
  .hero-kicker { color: var(--gold); font-size: 14px; letter-spacing: .08em; margin: 0 0 12px; }
  .hero h1 { font-size: 44px; line-height: 1.35; margin: 0 0 18px; border: 0; padding: 0; }
  .hero-lead { max-width: 620px; color: rgba(255,255,255,.85); margin: 0 0 28px; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-hours { font-size: 13px; color: rgba(255,255,255,.7); margin: 10px 0 0; }
  .hero-points { list-style: none; padding: 0; margin: 40px 0 0; display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-points li { border: 1px solid rgba(200,168,78,.45); border-radius: 8px; padding: 12px 18px; min-width: 140px; }
  .hero-points strong { display: block; font-size: 22px; color: var(--gold); }
  .hero-points span { font-size: 13px; color: rgba(255,255,255,.8); }
  .btn-gold, .btn-ghost, .btn-navy { display: inline-block; padding: 14px 22px; border-radius: 8px; font-weight: 700; text-decoration: none; }
  .btn-gold { background: var(--gold); color: var(--dark); }
  .btn-ghost { border: 1px solid rgba(255,255,255,.6); color: #fff; }
  .btn-navy { background: var(--navy); color: #fff; white-space: nowrap; }

  .sec { padding: 64px 0; }
  .sec-soft { background: var(--bg-soft); }
  .sec-kicker { color: var(--gold); font-size: 12px; letter-spacing: .2em; font-weight: 700; margin: 0; }
  .sec-title { font-size: 28px; margin: 4px 0 12px; border: 0; padding: 0; }
  .sec-lead { color: var(--sub); margin: 0 0 24px; max-width: 720px; }
  .sec-note { color: var(--sub); font-size: 14px; margin-top: 16px; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 24px; }
  .card { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 20px; }
  .card h3, .store h3 { margin: 0 0 12px; font-size: 17px; }
  .card-wide { margin-top: 16px; }
  .chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px; font-size: 14px; background: #fff; }
  .chips-soft li { background: var(--bg-soft); }
  .chips-lg li { font-size: 15px; padding: 8px 16px; border-color: var(--navy); color: var(--navy); font-weight: 500; }
  .col-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .col-card { display: flex; flex-direction: column; gap: 6px; background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--navy); border-radius: 8px; padding: 18px; text-decoration: none; color: var(--ink); }
  .col-card:hover { border-color: var(--navy); }
  .col-car { font-size: 13px; color: var(--sub); }
  .col-part { font-size: 17px; font-weight: 700; }
  .col-meta { font-size: 12px; color: var(--navy); }
  .more { margin: 20px 0 0; }
  .step { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 18px; display: flex; gap: 12px; align-items: flex-start; }
  .step span { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--navy); color: #fff; display: grid; place-items: center; font-weight: 700; }
  .step p { margin: 0; font-size: 15px; }
  .store { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 20px; }
  .store small { font-size: 13px; color: var(--sub); font-weight: 400; margin-left: 8px; }
  .store p { margin: 0 0 12px; font-size: 14px; }
  .store iframe { width: 100%; height: 240px; border: 0; border-radius: 6px; }
  .shop { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .company { max-width: 760px; background: #fff; }
  .company th { width: 130px; }
  .company td a { margin-right: 14px; display: inline-block; }
  .contact { background: var(--dark); color: #fff; text-align: center; padding: 56px 0; }
  .contact h2 { border: 0; padding: 0; font-size: 22px; margin: 0 0 20px; }
  .contact p { color: rgba(255,255,255,.7); font-size: 13px; }
  @media (max-width: 800px) {
    .hero h1 { font-size: 32px; }
    .grid2, .grid3, .col-grid { grid-template-columns: 1fr; }
    .sec { padding: 48px 0; }
    .sec-title { font-size: 23px; }
  }
</style>
