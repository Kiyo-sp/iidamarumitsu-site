---
// トップ。記載は現行サイト（docs/）と、仕入・販売実績で確認できた事実だけ。
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { COMPANY, POPULAR_PARTS, isPublic } from "../lib/site";

const publicColumns = await getCollection("column", (e) => isPublic(e.data.status));
const columns = publicColumns
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 6);
const asideColumns = ["air-conditioning-expansion-valve", "lower-arm-part-names"]
  .flatMap((id) => publicColumns.filter((entry) => entry.id === id));
const remainingColumns = publicColumns.filter((entry) => !asideColumns.includes(entry));
const columnGroups = [
  { name: "車種・型式別", articles: remainingColumns.filter(({ data }) => data.vehicle) },
  { name: "部品の基礎", articles: remainingColumns.filter(({ data }) => !data.vehicle) },
  { name: "小言コラム", articles: asideColumns },
];

const news = (await getCollection("news", (e) => isPublic(e.data.status)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const companyInfo: [string, string][] = [
  ["会社名", COMPANY.name],
  ["代表者", "水川慎也"],
  ["資本金", "1,200万円"],
  ["創業", "昭和53年（1978年）3月"],
  ["本店", COMPANY.stores[0].address],
  ["生田店", COMPANY.stores[1].address],
  ["TEL", COMPANY.tel],
  ["事業内容", "自動車部品・工具卸売業"],
  ["取引銀行", "飯田信用金庫、八十二銀行"],
  ["株主", "株式会社SPREAD（70%）／株式会社門田商店（30%）"],
];
const groups = [
  { name: "株式会社SPREAD", href: "https://spread-inc.co.jp/" },
  { name: "株式会社イー・エヌ・ドゥ", href: "https://e-n-do.com/" },
  { name: "株式会社門田商店", href: "https://kadota-works.co.jp/" },
];
const customers = ["整備工場", "板金・塗装工場", "カーディーラー", "中古車販売店", "タクシー・運送会社", "官公庁"];

const jsonLd = [{
  "@context": "https://schema.org", "@type": "AutoPartsStore", name: COMPANY.name, url: COMPANY.url + "/",
  description: "長野県飯田市の自動車部品・工具の専門卸売業。昭和53年創業。",
  telephone: COMPANY.tel, foundingDate: "1978",
  address: { "@type": "PostalAddress", streetAddress: "大久保町2565-6", addressLocality: "飯田市", addressRegion: "長野県", postalCode: "395-0053", addressCountry: "JP" },
  openingHours: "Mo-Fr 08:30-17:30",
  parentOrganization: { "@type": "Organization", name: "株式会社SPREAD" },
}];
const mapSrc = (q: string) => `https://maps.google.com/maps?q=${encodeURIComponent(q)}&z=14&output=embed`;
---
<BaseLayout
  title={`${COMPANY.name}｜長野県飯田市の自動車部品・工具卸売`}
  description="長野県飯田市の自動車部品・工具卸売。昭和53年創業。飯田本店と生田店の2拠点体制で1日複数回デリバリー。国産全メーカーの純正部品と主要な優良部品を取り扱っています。"
  jsonLd={jsonLd} ogType="website" wide
>
  <section class="hero">
    <div class="wide hero-inner">
      <div class="hero-text-panel"><p class="hero-kicker">長野県飯田市の自動車部品・工具卸　昭和53年創業</p>
      <h1>必要な部品を、<br />必要なときに。</h1>
      <p class="hero-lead">飯田の中心部と北部の2拠点から、整備工場・ディーラーの現場へ1日に何度でもお届けします。</p>
      </div>
      <section class="hero-inquiry" aria-labelledby="hero-inquiry-heading">
        <h2 id="hero-inquiry-heading">在庫・適合を問い合わせる</h2>
        <p>車台番号が分かれば、品番をお調べします。</p>
        <div class="hero-actions">
        <a class="btn-gold" href={COMPANY.telHref}>☎ {COMPANY.tel}　電話で問い合わせる</a>
        <a class="preview-cta" href="/contact/">メールでのお問い合わせ</a>
        </div>
        <p class="hero-hours">受付：{COMPANY.hours}</p>
      </section>
      <div class="hero-resources">
        <a href="/parts/">取扱部品・用品を見る →</a>
        <a href="/column/">部品コラムを見る →</a>
      </div>
      <ul class="hero-points">
        <li><strong>2拠点</strong><span>本店・生田店</span></li>
        <li><strong>1日複数回</strong><span>デリバリー</span></li>
        <li><strong>45年以上</strong><span>地域とともに</span></li>
      </ul>
    </div>
  </section>

  {news.length > 0 && (
    <section class="news-bar">
      <div class="wide">
        <ul aria-label="お知らせ" tabindex={news.length > 3 ? 0 : undefined}>
          {news.map((e) => <li><time>{e.data.date.toISOString().slice(0, 10)}</time><a href={`/news/${e.id}/`}>{e.data.title}</a></li>)}
        </ul>
        <a class="news-more" href="/news/">お知らせ一覧 →</a>
      </div>
    </section>
  )}

  <section class="sec" id="parts">
    <div class="wide">
      <p class="sec-kicker">PARTS</p>
      <h2 class="sec-title">取扱部品</h2>
      <p class="sec-lead">国産全メーカーの純正部品と、主要メーカーの優良部品を取り扱っています。在庫にないものもお取り寄せします。</p>
      <div class="grid2">
        <div class="card">
          <h3>純正部品</h3>
          <ul class="top-maker-logos"><li><img src="/site-media/logo-ede841bae07f58ba.png" alt="" loading="lazy"><span>トヨタ</span></li><li><img src="/site-media/logo-ccae467533b7e310.png" alt="" loading="lazy"><span>日産</span></li><li><img src="/site-media/logo-395613072d9fb7e8.png" alt="" loading="lazy"><span>ホンダ</span></li><li><img src="/site-media/logo-73d53da85d010261.png" alt="" loading="lazy"><span>スズキ</span></li><li><img src="/site-media/logo-b1f71f3403fd1f3b.png" alt="" loading="lazy"><span>ダイハツ</span></li><li><img src="/site-media/logo-39fe368def525a54.png" alt="" loading="lazy"><span>スバル</span></li><li><img src="/site-media/logo-580c6d0f5c0c7222.png" alt="" loading="lazy"><span>三菱</span></li><li><img src="/site-media/logo-905731c0a7dd4e2e.png" alt="" loading="lazy"><span>マツダ</span></li><li><img src="/site-media/ISUZU-%E3%83%AD%E3%82%B4.png" alt="" loading="lazy"><span>いすゞ</span></li><li><img src="/site-media/FUSO-%E3%83%AD%E3%82%B4.png" alt="" loading="lazy"><span>三菱ふそう</span></li></ul>
        </div>
        <div class="card">
          <h3>優良部品メーカー（主な取扱い）</h3>
          <ul class="top-maker-logos"><li><img src="/site-media/logo-055217bfa6ea771e.png" alt="" loading="lazy"><span>日本マイクロフイルター工業</span></li><li><img src="/site-media/logo-39cd489875225b53.png" alt="Astemo" loading="lazy"><span>トキコ</span></li><li><img src="/site-media/logo-a5ba1399185383aa.png" alt="" loading="lazy"><span>GMB</span></li><li><img src="/site-media/logo-a21f3ba5c49703e1.png" alt="" loading="lazy"><span>バンドー化学</span></li><li><img src="/site-media/%E5%A4%A7%E9%87%8E%E3%82%B4%E3%83%A0%E5%B7%A5%E6%A5%AD%E3%83%AD%E3%82%B4.png" alt="" loading="lazy"><span>大野ゴム工業</span></li><li><img src="/site-media/logo-95d9395a9e9e7503.png" alt="" loading="lazy"><span>日本特殊陶業</span></li><li><span>デンソー</span></li><li><img src="/site-media/logo-df8032398e81cdf2.png" alt="" loading="lazy"><span>DIXCEL</span></li><li><img src="/site-media/logo-27a6c93cfa8e0f5c.png" alt="" loading="lazy"><span>武蔵オイルシール工業</span></li><li><img src="/site-media/logo-8fb97afc0ea1506c.png" alt="" loading="lazy"><span>スタンレー電気</span></li></ul>
        </div>
      </div>
      <div class="parts-menu-after-makers"><p><a href="/parts/">取扱部品・用品を見る</a></p><nav class="part-choice-nav" aria-label="取扱部品の分類"><ul class="part-choice-list"><li><a href="/parts/genuine/"><span>純正部品・第2ブランド</span><span aria-hidden="true">→</span></a></li><li><a href="/parts/repair/"><span>機能部品・消耗部品</span><span aria-hidden="true">→</span></a></li><li><a href="/parts/electrical/"><span>電気・電装系部品</span><span aria-hidden="true">→</span></a></li><li><a href="/parts/recycled/"><span>リビルト・中古部品</span><span aria-hidden="true">→</span></a></li><li><a href="/parts/chemical/"><span>ケミカル・オイル</span><span aria-hidden="true">→</span></a></li><li><a href="/parts/tools/"><span>工具・整備用品 <small>今後展開予定</small></span><span aria-hidden="true">→</span></a></li></ul></nav></div>
      <div class="card card-wide">
        <h3>よくご注文いただく部品</h3>
        <ul class="chips chips-soft">{POPULAR_PARTS.map((m) => <li>{m}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="sec" id="business">
    <div class="wide">
      <p class="sec-kicker">FOR BUSINESS</p>
      <h2 class="sec-title">法人のお客様へ</h2>
      <p class="sec-lead">飯田・下伊那エリアの、さまざまな業種のお客様に部品をお届けしています。</p>
      <ul class="chips chips-lg">{customers.map((c) => <li>{c}</li>)}</ul>
      <div class="grid3">
        <div class="step"><span>1</span><p>お電話で、車台番号と必要な部品をお伝えください。</p></div>
        <div class="step"><span>2</span><p>品番と在庫・納期を確認してご連絡します。</p></div>
        <div class="step"><span>3</span><p>本店・生田店から、現場へお届けします。</p></div>
      </div>
      <p class="more"><a href="/business/">法人のお客様向けのご案内 →</a></p>
    </div>
  </section>

  <section class="sec sec-soft" id="stores">
    <div class="wide">
      <p class="sec-kicker">STORES</p>
      <h2 class="sec-title">店舗</h2>
      <p class="sec-lead">飯田中心部の本店と北側の生田店（2店舗間 約15km）。南北からエリア全体をカバーします。</p>
      <div class="grid2">
        {COMPANY.stores.map((st) => (
          <div class="store">
            <h3>{st.name}<small>{st.area}</small></h3>
            <p>{st.address}</p>
            <iframe title={`${st.name}の地図`} src={mapSrc(st.map)} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        ))}
      </div>
      <p class="sec-note">TEL {COMPANY.tel}（{COMPANY.hours}）</p>
    </div>
  </section>

  <section class="sec" id="shop">
    <div class="wide shop">
      <div>
        <p class="sec-kicker">ONLINE SHOP</p>
        <h2 class="sec-title">個人のお客様は、メルカリShopsでも</h2>
        <p class="sec-lead">一部の部品はメルカリShopsでも販売しています。</p>
      </div>
      <a class="btn-navy shop-logo-button" href={COMPANY.mercari} target="_blank" rel="noopener"><img src="/site-media/mercari-shops-logo.png" alt="メルカリShops" /><span>ショップを見る →</span></a>
    </div>
  </section>

  <section class="sec sec-soft" id="column">
    <div class="wide">
      <p class="sec-kicker">COLUMN</p>
      <h2 class="sec-title">部品コラム</h2>
      <p class="sec-lead">車種・型式ごとに、販売明細に記録された品番と、部品選びで確認したいポイントをまとめています。</p>
      <div class="col-grid">
        {columns.map((e) => {
          const excludedNumbers = new Set((e.data.excludedPartNumbers ?? []).map((item) => item.number));
          const listedPartCount = e.data.facts?.partNumbers.filter((item) => !excludedNumbers.has(item.number)).length ?? 0;
          return (
          <a class="col-card" href={`/column/${e.id}/`}>
            <span class="col-car">{e.data.vehicle ? `${e.data.vehicle.maker} ${e.data.vehicle.name} ${e.data.vehicle.model}` : "部品の基礎"}</span>
            <span class="col-part">{e.data.part?.name}</span>
            {e.data.facts && <span class="col-meta">販売明細集計 {e.data.facts.shipments}件 ／ 掲載品番 {listedPartCount}種</span>}
          </a>
          );
        })}
      </div>
      <section class="other-columns" aria-labelledby="home-column-list-heading">
        <h3 id="home-column-list-heading">コラム一覧</h3>
        <p><a href="/column/">コラム一覧・検索ページへ →</a></p>
        <div class="home-column-list" tabindex="0" role="region" aria-labelledby="home-column-list-heading">
          {columnGroups.map(({ name, articles }) => (
            <div>
              <h4>{name}</h4>
              <ul class="aside-column-links">
                {articles.map(({ id, data }) => (
                  <li><a href={`/column/${id}/`}>{data.title}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
      <div class="other-columns" id="other-columns">
        <h3>その他</h3>
        <div class="aside-column-card">
          <h4>小言コラム</h4>
          <p>日々の仕事で感じたことや、ちょっとした話を綴ります。</p>
          <ul class="aside-column-links">
            {asideColumns.map(({ id, data }) => (
              <li><a href={`/column/${id}/`}>{data.title}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <p class="more"><a href="/column/">コラムの一覧へ →</a></p>
    </div>
  </section>

  <section class="sec sec-soft" id="company">
    <div class="wide">
      <p class="sec-kicker">COMPANY</p>
      <h2 class="sec-title">会社概要</h2>
      <a class="preview-cta" href="/company/">詳しい会社概要を見る →</a>
      <table class="company">
        <tbody>
          {companyInfo.map(([k, v]) => <tr><th>{k}</th><td>{v}</td></tr>)}
          <tr><th>グループ会社</th><td>{groups.map((g) => <a href={g.href} target="_blank" rel="noopener">{g.name}</a>)}</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <style is:inline>:root{--dark:#0c1829;--gold:#c8a84e;--navy:#1a4b8e;--ink:#1d1d1f;--sub:#5f6368;--line:#e3e7ee;--bg-soft:#f5f8fc;--warn-bg:#fff7e6;--warn:#8a5300}*{box-sizing:border-box}body{color:var(--ink);-webkit-font-smoothing:antialiased;background:#fff;margin:0;font-family:Noto Sans JP,system-ui,sans-serif;line-height:1.8}a{color:var(--navy)}.wrap{max-width:760px;margin:0 auto;padding:0 16px}.wide{max-width:1080px;margin:0 auto;padding:0 16px}main.main-wide{padding:0}.site-header{border-bottom:1px solid var(--line);z-index:10;background:#fff;position:sticky;top:0}.header-inner{flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;min-height:56px;display:flex}.logo{color:var(--ink);font-weight:700;text-decoration:none}nav{flex-wrap:wrap;gap:16px;font-size:14px;display:flex}nav a{color:var(--ink);text-decoration:none}.nav-tel{font-weight:700;color:var(--navy)!important}main{padding:24px 16px 56px}h1{margin:8px 0 16px;font-size:24px;line-height:1.5}h2{border-left:4px solid var(--navy);margin:40px 0 12px;padding-left:10px;font-size:19px;line-height:1.5}h3{margin:28px 0 8px;font-size:16px}table{border-collapse:collapse;width:100%;margin:8px 0 4px;font-size:14px}th,td{border:1px solid var(--line);text-align:left;vertical-align:top;padding:8px 10px}th{background:var(--bg-soft);font-weight:500}.table-scroll{overflow-x:auto}.note{color:var(--sub);margin:4px 0 0;font-size:13px}.site-footer{border-top:1px solid var(--line);background:var(--bg-soft);color:var(--sub);padding:24px 0;font-size:13px}.site-footer p{margin:2px 0}.f-name{color:var(--ink);font-weight:700}.f-copy{margin-top:12px!important}@media (width<=600px){h1{font-size:21px}.header-inner{flex-wrap:nowrap;min-height:48px}.logo{flex:none;font-size:15px}nav{white-space:nowrap;scrollbar-width:none;flex-wrap:nowrap;gap:14px;font-size:13px;overflow-x:auto}}

.preview-cta{display:inline-block;margin:0 0 14px;padding:10px 16px;background:#1a4b8e;color:white;border-radius:7px;text-decoration:none;font-weight:700}.hero .preview-cta{background:white;color:#172e4a;margin:0}
.site-header .marumitsu-type{display:inline-grid;gap:3px;line-height:1.05;white-space:nowrap;color:#0c1829;padding-bottom:3px}.marumitsu-type .marumitsu-prefix{font-size:10px;letter-spacing:.18em;font-weight:600}.marumitsu-type strong{font-size:23px;letter-spacing:.025em}.marumitsu-core{border-bottom:2px solid #c8a84e;padding-bottom:2px}@media(max-width:600px){.marumitsu-type strong{font-size:19px}}
.site-header .rotor-brand{display:inline-flex;align-items:center;gap:9px;padding-bottom:0}.rotor-wordmark{display:grid;gap:4px}.rotor-description{font-size:10px;font-weight:650;letter-spacing:.1em;color:#41546b}.rotor-icon{position:relative;flex:none;width:43px;height:39px}.rotor-disc{position:absolute;inset:2px 7px 2px 1px;border:4px solid #0c1829;border-radius:50%;box-shadow:inset 0 0 0 1px #62778c}.rotor-disc:before{content:"";position:absolute;inset:8px;border:2px solid #0c1829;border-radius:50%}.rotor-disc i{position:absolute;width:3px;height:3px;border-radius:50%;background:#0c1829}.rotor-disc i:nth-child(1){left:8px;top:2px}.rotor-disc i:nth-child(2){left:3px;top:12px}.rotor-disc i:nth-child(3){left:8px;bottom:2px}.rotor-caliper{position:absolute;right:1px;top:7px;width:15px;height:23px;background:#aa7d24;border:2px solid white;border-radius:4px 8px 8px 4px;transform:rotate(-14deg)}@media(max-width:600px){.rotor-icon{transform:scale(.86);width:39px}.rotor-description{font-size:9px}}
.delivery-mark{position:relative;display:block;flex:none;width:52px;height:37px;color:#0c1829}.delivery-mark i{position:absolute;display:block}.truck-box{inset:4px 20px 11px 1px;border:2px solid currentColor;border-radius:3px;background:linear-gradient(to bottom,#fff 46%,#bb9240 46%,#bb9240 61%,#fff 61%)}.truck-cab{inset:10px 1px 10px 34px;background:currentColor;clip-path:polygon(0 0,63% 0,100% 45%,100% 100%,0 100%)}.truck-cab::before{content:"";position:absolute;inset:3px 3px auto 3px;height:6px;background:#fff;clip-path:polygon(0 0,58% 0,100% 100%,0 100%)}.truck-frame{inset:auto 1px 8px;height:4px;background:currentColor;border-radius:2px}.truck-wheel{bottom:3px;left:7px;width:11px;height:11px;background:currentColor;border:2px solid #fff;border-radius:50%}.truck-wheel:last-child{left:auto;right:5px}@media(max-width:600px){.delivery-mark{transform:scale(.88);margin-inline:-3px}}
.delivery-mark{width:95px}.delivery-mark .truck-box{position:absolute;inset:4px 1px 11px 23px;display:grid;place-items:center;background:#fff;border-bottom-color:#aa7d24}.truck-lettering{color:#0c1829;font-size:7px;font-weight:700;line-height:1;white-space:nowrap}.delivery-mark .truck-cab{inset:10px auto 10px 1px;width:20px;transform:scaleX(-1)}.delivery-mark .truck-wheel{left:8px}.delivery-mark .truck-wheel:last-child{left:auto;right:12px}@media(max-width:600px){.delivery-mark{transform:none;margin-inline:0;width:89px}.truck-lettering{font-size:6.5px}}

.site-header .rotor-brand{gap:0;padding:2px 0}
.delivery-mark{width:181px;height:46px;color:#102138}
.delivery-mark .truck-box{position:absolute;inset:2px 1px 11px 33px;display:grid;place-items:center;padding:0 4px 3px;border:0;border-radius:2px 3px 2px 2px;background:linear-gradient(to bottom,#102138 0 calc(100% - 3px),#c8a84e calc(100% - 3px));}
.truck-lettering{color:#fff;font-size:18px;font-weight:700;letter-spacing:.07em;line-height:1;white-space:nowrap}
.delivery-mark .truck-cab{inset:9px auto 9px 1px;width:34px;transform:scaleX(-1);clip-path:polygon(0 0,55% 0,73% 12%,100% 59%,100% 100%,0 100%);}
.delivery-mark .truck-cab::before{inset:4px 5px auto 7px;height:9px;background:#e8eff6;clip-path:polygon(0 0,56% 0,100% 100%,0 100%);}
.delivery-mark .truck-cab::after{content:"";position:absolute;right:0;bottom:4px;width:5px;height:3px;background:#c8a84e;}
.delivery-mark .truck-frame{inset:auto 1px 8px;height:4px;}
.delivery-mark .truck-wheel{bottom:1px;left:11px;width:13px;height:13px;border:1.5px solid #fff;background:radial-gradient(circle,#8391a0 0 21%,#102138 25%);}
.delivery-mark .truck-wheel:last-child{left:auto;right:18px;}
@media(max-width:600px){.delivery-mark{transform:none;margin-inline:0;width:157px;height:43px}.truck-lettering{font-size:15px;letter-spacing:.035em}}


.delivery-mark{width:190px;height:49px}
.delivery-mark .truck-box{inset:2px 2px 13px 48px;border-radius:2px;border-left:1px solid #53647a;border-right:2px solid #53647a}
.delivery-mark .truck-cab{inset:8px auto 11px 5px;width:41px;transform:none;clip-path:polygon(21% 0,91% 0,100% 10%,100% 92%,76% 92%,73% 78%,65% 69%,53% 65%,40% 69%,31% 79%,28% 95%,0 95%,0 56%,5% 48%,8% 21%)}
